"""Show a status-bar icon while a hardware kill switch is engaged.

The FuriPhone FLX1 has two sliding switches wired to GPIO 51 (camera) and
GPIO 52 (cellular). FuriLabs' own `custom_keys` kernel driver exports their
position under /sys/devices/platform/custom-keys/ and reports KEY_CAMERA /
KEY_F2 on an input device -- but that input device is held exclusively
(EVIOCGRAB) by the Android-side NVRAM HAL, so no Linux program can ever see
those key events. sysfs is the only readable source, and it is readable
without root because Android's `system` UID 1000 is the host's `furios`.

Nothing on the FuriOS side displays this state: there is no rfkill device for
the switches, and phosh's top bar keeps showing cellular bars from the last
known modem state. That is the gap this fills.
"""
import argparse
import array
import configparser
import json
import math
import os
import signal
import subprocess
import sys
import tempfile
import threading
import time
import wave

BASE = os.environ.get("FURIOS_KILLSWITCH_BASE", "/sys/devices/platform/custom-keys")

# (sysfs attribute, icon shown while engaged, human label)
# Attribute reads "1" when the switch lets the hardware work and "0" when it
# is engaged -- the driver logs the same as "pressed: 0" on the falling edge.
SWITCHES = [
    ("cam_switch", "camera-disabled-symbolic", "Kamera"),
    ("nwk_switch", "network-cellular-disabled-symbolic", "Mobilfunk"),
]
ENGAGED = "0"

# The third switch -- the microphone one -- has no readable state at all. It is
# the only one of the three that physically cuts the line, and that is exactly
# why the system cannot see it: an internal microphone is not a device that
# announces itself, it is an analogue line into a codec input. Compared between
# engaged and free with no difference whatsoever: every GPIO, every Android
# property, every ALSA control, /proc/asound, jack states, input devices
# (448 + 1889 lines). Only listening tells them apart.
#
# And listening is what this service no longer does. Telling the two states
# apart means opening the microphone -- the one thing somebody flips that
# switch to prevent -- and the answer only ever covers the three seconds it
# was open. The switch announces itself nowhere, so flipping it while the
# screen is on triggers nothing at all: the icon would be right some of the
# time and silently wrong the rest, which is worse than no icon. The housing
# is the display for this one. What is left below serves `mic-check` only --
# a measurement asked for by hand, never taken on our own initiative.
#
# Measured on the device, 5 runs per state, 3 s each, first 0.7 s of stream
# startup discarded, RMS taken per 200 ms block:
#
#   engaged   median 2.84  2.85  2.89  2.93  3.14
#   free      median 8.72  25.71 25.77 28.85 50.94
#
# The MEDIAN of those blocks is the discriminator. Two candidates were tried
# and rejected against this data:
#   - level (mean RMS): a single click pulls it far off; one engaged run read
#     6.92 with peak 107.
#   - jitter: looked convincing at first, but a quiet-room run with the
#     microphone LIVE came in at 13.8 % and would have been reported as
#     engaged. That is the one error that must not happen -- claiming the
#     microphone is cut while it is listening.
# The median is immune to single disturbed blocks, and the converter's noise
# floor turns out to be remarkably stable across runs.
MIC_MEASURE_S = 3.0        # length of one measurement
MIC_SKIP_S = 0.7           # stream startup, measured: first blocks read near 0
MIC_SOURCE = "droid-source"
# All three must hold before the icon is shown. Erring towards "free" is the
# safe direction: claiming the microphone is off while it listens would be the
# one failure that matters.
# Halfway between the two groups, leaning towards "free": engaged tops out at
# 3.14, free bottoms out at 8.72.
MIC_MAX_MEDIAN = 4.5
# Below this, something is wrong rather than quiet -- a stream handing out
# digital silence must never be read as "the line is cut".
MIC_MIN_MEDIAN = 0.5

def _config_home():
    """The user's config directory, even when started through sudo.

    `sudo` moves HOME to /root, and the one command here that needs root -- the
    one-off camera query -- would otherwise write its cache where the user can
    never read it. Which is exactly what happened the first time.
    """
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and os.geteuid() == 0:
        import pwd
        try:
            return os.path.join(pwd.getpwnam(sudo_user).pw_dir, ".config")
        except KeyError:
            pass
    return os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))


CONFIG_DIR = os.path.join(_config_home(), "furios-killswitch")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.ini")
STATE_FILE = os.path.join(CONFIG_DIR, "state.json")

# What the network switch may take down IN ADDITION to what it already does.
# The switch itself only kills the RIL; Wi-Fi and Bluetooth keep running. These
# extend its reach in software, for people who read that switch as "radios off".
# Both default to off: a switch that silently does more than it says is worse
# than one that does too little.
RADIOS = {
    "wifi": ("Wi-Fi", "org.freedesktop.NetworkManager", "/org/freedesktop/NetworkManager",
             "org.freedesktop.NetworkManager", "WirelessEnabled"),
    "bluetooth": ("Bluetooth", "org.bluez", "/org/bluez/hci0",
                  "org.bluez.Adapter1", "Powered"),
}


def load_config():
    parser = configparser.ConfigParser()
    parser.read(CONFIG_FILE)
    if not parser.has_section("network"):
        parser.add_section("network")
    return parser


def config_enabled(parser, radio):
    return parser.getboolean("network", radio, fallback=False)


def save_config(parser):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as handle:
        parser.write(handle)


def load_state():
    try:
        with open(STATE_FILE) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = STATE_FILE + ".neu"
    with open(tmp, "w") as handle:
        json.dump(state, handle)
    os.replace(tmp, STATE_FILE)

BAR_HEIGHT = 32          # logical px; phosh's top bar, icons centred inside it
# Right-aligned, but clear of what phosh already puts there: location, battery
# and the percentage occupy roughly the rightmost 90 logical px.
RIGHT_MARGIN = 104
ICON_SIZE = 16           # matches the size phosh uses for its own indicators
# Measured on the device: the driver does NOT call sysfs_notify(). poll() on
# the attributes stayed silent through a full switch cycle while the value
# provably changed, so this timer is not a safety net -- it is the only source
# of updates, and the interval is the delay before the icon appears.
# At 2 s it costs 0.0154 % of one core, i.e. 13.3 s of CPU time per day.
DEFAULT_INTERVAL_S = 2

CSS = b"""
#killswitch-box { background: transparent; }
#killswitch-box image {
    color: #ffb648;
    -gtk-icon-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}
"""


def read_switch(name):
    """Return the raw attribute value, or None when it cannot be read."""
    try:
        with open(os.path.join(BASE, name)) as handle:
            return handle.read().strip()
    except OSError:
        return None


def classify_microphone(median):
    """True = line is cut, False = live, None = measurement not trustworthy.

    Kept separate from the measuring so the thresholds can be tested against
    the recorded values without a microphone.
    """
    if median is None or median < MIC_MIN_MEDIAN:
        return None
    return median < MIC_MAX_MEDIAN


def measure_microphone(seconds=MIC_MEASURE_S):
    """Record briefly and return (median block RMS, peak), or None if it failed."""
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        path = tmp.name
    try:
        proc = subprocess.Popen(
            ["pw-record", "--target", MIC_SOURCE, "--rate", "48000",
             "--channels", "1", "--format", "s16", path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(seconds)
        # SIGINT, not kill: pw-record has to finish the WAV header, otherwise
        # the file cannot be read back at all.
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()
        if os.path.getsize(path) < 2000:
            return None
        with wave.open(path) as handle:
            rate = handle.getframerate()
            samples = array.array("h")
            samples.frombytes(handle.readframes(handle.getnframes()))
        samples = samples[int(MIC_SKIP_S * rate):]
        if len(samples) < rate // 2:
            return None
        block = rate // 5                      # 200 ms
        blocks = sorted(math.sqrt(sum(x * x for x in samples[i:i + block]) / block)
                        for i in range(0, len(samples) - block, block))
        if not blocks:
            return None
        return blocks[len(blocks) // 2], max(abs(x) for x in samples)
    except (OSError, wave.Error, subprocess.SubprocessError):
        return None
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


def engaged_switches():
    return [(n, i, l) for n, i, l in SWITCHES if read_switch(n) == ENGAGED]


def radio_state(radio):
    """True/False, or None when the service behind it is not reachable."""
    from gi.repository import Gio, GLib
    _label, service, path, iface, prop = RADIOS[radio]
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        value = bus.call_sync(
            service, path, "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", (iface, prop)), GLib.VariantType("(v)"),
            Gio.DBusCallFlags.NONE, 3000, None)
        return bool(value[0])
    except GLib.Error:
        return None


def set_radio(radio, enabled):
    """Switch one radio. Returns True when it went through."""
    from gi.repository import Gio, GLib
    _label, service, path, iface, prop = RADIOS[radio]
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        bus.call_sync(
            service, path, "org.freedesktop.DBus.Properties", "Set",
            GLib.Variant("(ssv)", (iface, prop, GLib.Variant("b", enabled))),
            None, Gio.DBusCallFlags.NONE, 5000, None)
        return True
    except GLib.Error as err:
        print(f"{radio}: {err.message}", file=sys.stderr)
        return False


def apply_network_extras(engaged, verbose=False):
    """Take down (or bring back) the extra radios when the switch moves.

    Only radios this program switched off are switched back on. Someone who
    turned Wi-Fi off by hand before flipping the switch should not find it on
    afterwards -- restoring something the user did not ask for is the kind of
    surprise that makes people distrust the whole thing.
    """
    config = load_config()
    state = load_state()
    ours = set(state.get("we_disabled", []))
    for radio in RADIOS:
        if not config_enabled(config, radio):
            continue
        if engaged:
            if radio_state(radio) is True and set_radio(radio, False):
                ours.add(radio)
                if verbose:
                    print(f"{radio}: ausgeschaltet (Netzschalter)", flush=True)
        elif radio in ours:
            if set_radio(radio, True):
                ours.discard(radio)
                if verbose:
                    print(f"{radio}: wieder eingeschaltet", flush=True)
    state["we_disabled"] = sorted(ours)
    save_state(state)


CAMERA_CACHE = os.path.join(CONFIG_DIR, "cameras.json")


def list_cameras(refresh=False):
    """Which cameras exist and which way they face.

    Asking the Android side needs root (lxc-attach), so the answer is cached:
    the number of cameras in a phone does not change. Everything else here runs
    without root, and one root call to write a file once should not turn into a
    daemon that needs it.
    """
    if not refresh:
        try:
            with open(CAMERA_CACHE) as handle:
                return json.load(handle)
        except (OSError, ValueError):
            pass
    try:
        out = subprocess.run(
            ["/usr/bin/lxc-attach", "-n", "android", "--",
             "/system/bin/dumpsys", "media.camera"],
            capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    facings = [line.split(":", 1)[1].strip()
               for line in out.splitlines() if line.strip().startswith("Facing:")]
    if not facings:
        return None
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CAMERA_CACHE, "w") as handle:
            json.dump(facings, handle)
        _give_back(CONFIG_DIR)
        _give_back(CAMERA_CACHE)
    except OSError:
        pass
    return facings


def _give_back(path):
    """Hand a file written under sudo back to the user it belongs to."""
    uid = os.environ.get("SUDO_UID")
    gid = os.environ.get("SUDO_GID")
    if uid and gid and os.geteuid() == 0:
        try:
            os.chown(path, int(uid), int(gid))
        except OSError:
            pass


def camera_hal_running():
    """True/False from the Android property, or None when it cannot be read.

    This is the direct answer to "is the camera switch engaged right now" from
    the other end: the switch works by stopping exactly this service.
    """
    try:
        out = subprocess.run(["getprop", "init.svc.camerahalserver"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return {"running": True, "stopped": False}.get(out)


def cmd_cameras(args):
    cams = list_cameras(refresh=getattr(args, "refresh", False))
    if cams is None:
        print("Camera list not known yet. Fetch it once as root:")
        print("  sudo killswitch-indicator cameras --refresh")
        return 1
    print(f"{len(cams)} cameras, all of them affected by the switch:")
    for index, facing in enumerate(cams):
        seite = {"Back": "Rueckseite", "Front": "Vorderseite"}.get(facing, facing)
        print(f"  Kamera {index}: {seite}")
    print("The switch stops camerahalserver - that always applies to all "
          "cameras at once, one alone is not possible.")
    return 0


def cmd_config(args):
    config = load_config()
    if args.radio is None:
        for radio, (label, *_rest) in RADIOS.items():
            print(f"{radio:10s} {'yes' if config_enabled(config, radio) else 'no':5s}"
                  f"  # switch {label} off with the network switch")
        return 0
    if args.value is None:
        print("yes" if config_enabled(config, args.radio) else "no")
        return 0
    config.set("network", args.radio, "yes" if args.value == "on" else "no")
    save_config(config)
    print(f"{args.radio}: {'yes' if args.value == 'on' else 'no'}")
    return 0


def cmd_status(args):
    """Print switch positions without needing a display. Also used by the tests."""
    if getattr(args, "json", False):
        config = load_config()
        state = load_state()
        data = {
            "switches": {name: read_switch(name) for name, _i, _l in SWITCHES},
            "network_extras": {r: config_enabled(config, r) for r in RADIOS},
            "radios": {r: radio_state(r) for r in RADIOS},
            "we_disabled": state.get("we_disabled", []),
            "cameras": list_cameras(),
            "camera_hal": camera_hal_running(),
        }
        print(json.dumps(data, indent=2))
        return 0
    missing = False
    for name, _, label in SWITCHES:
        value = read_switch(name)
        if value is None:
            print(f"{name}: not readable ({os.path.join(BASE, name)})")
            missing = True
        else:
            print(f"{name}: {'ENGAGED' if value == ENGAGED else 'free'} (sysfs={value})  # {label}")
    return 1 if missing else 0


class Indicator:
    """A click-through layer-shell strip drawn inside the top bar."""

    def __init__(self, verbose=False, interval=DEFAULT_INTERVAL_S):
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import Gtk, GLib, GtkLayerShell
        import cairo
        try:                                     # GLib.unix_fd_add_full is deprecated
            from gi.repository import GLibUnix
            self.fd_add = GLibUnix.fd_add_full
        except (ImportError, ValueError):
            self.fd_add = GLib.unix_fd_add_full

        self.Gtk, self.GLib, self.GtkLayerShell, self.cairo = Gtk, GLib, GtkLayerShell, cairo
        self.verbose = verbose
        self.interval = interval
        self.state = {}
        # Whether the compositor has been told that this strip takes no touch.
        # False until a draw has actually pushed it - see on_draw.
        self.input_region_set = False

        self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.win.set_app_paintable(True)
        screen = self.win.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.win.set_visual(visual)

        GtkLayerShell.init_for_window(self.win)
        # OVERLAY, not TOP: phosh's own top bar sits on TOP and is drawn over
        # anything else there, which leaves the icon invisible. Verified on the
        # device -- on TOP the window maps and reports a size, and still cannot
        # be seen in a screenshot.
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self.win, edge, True)
        # -1: reserve no space of our own and do not get pushed below the bar
        # that already reserves some.
        GtkLayerShell.set_exclusive_zone(self.win, -1)
        GtkLayerShell.set_namespace(self.win, "killswitch-indicator")

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.box.set_name("killswitch-box")
        self.box.set_halign(Gtk.Align.END)
        self.box.set_margin_end(RIGHT_MARGIN)
        self.box.set_valign(Gtk.Align.CENTER)
        self.win.set_size_request(-1, BAR_HEIGHT)
        self.win.add(self.box)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.icons = {}
        for name, icon, _label in SWITCHES:
            image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
            image.set_pixel_size(ICON_SIZE)
            image.set_no_show_all(True)          # visibility is ours to decide
            self.box.pack_start(image, False, False, 0)
            self.icons[name] = image

        # No third icon: the microphone switch is not read here, by choice --
        # see the note at the top.

        # Not "realize" - see on_draw. The window is anchored across the
        # whole width of the top bar, so getting this wrong takes the swipe
        # to the quick settings with it.
        self.win.connect("draw", self.on_draw)
        self.win.connect("map-event", self.on_map_event)
        self.win.connect("size-allocate", self.on_size_allocate)
        self.win.connect("destroy", Gtk.main_quit)
        self.win.show_all()
        self.refresh(initial=True)
        self.watch()
        self.forget_stale_mic_state()

    def on_draw(self, _widget, _cr):
        """Let every touch through: an empty input region.

        Without this the strip swallows the swipe that opens phosh's quick
        settings, right where people reach for it - the window is anchored
        left AND right, so it lies across the whole top bar.

        From `realize`, where this used to sit, it did nothing at all. Traced
        on the device with WAYLAND_DEBUG=1 on 15.09.2026: the strip went up
        with `wl_surface.set_input_region(nil)`, and nil is Wayland for "all
        of me takes input". Two reasons, and either one is enough - the
        surface a region is set on at realize time is not the one the window
        ends up with (gtk-layer-shell swaps it for a layer surface before the
        window maps), and GDK pushes the region to the compositor only while
        it paints, so a call at any other moment sits in a field nobody
        sends. Set from here, the same call arrives as an empty wl_region -
        `create_region`, no `add`, `set_input_region` - which is the strip
        saying it wants no touch at all.

        Once per surface, not per frame: re-armed by whatever can lose it.
        """
        if not self.input_region_set:
            gdk_window = self.win.get_window()
            if gdk_window is not None:
                gdk_window.input_shape_combine_region(self.cairo.Region(), 0, 0)
                self.input_region_set = True
                if self.verbose:
                    print("input region emptied - the strip accepts no "
                          "Beruehrung an", flush=True)
        return False

    def on_map_event(self, _widget, _event):
        """A new surface may carry no region of ours; the next draw sets it."""
        self.input_region_set = False
        return False

    def on_size_allocate(self, _widget, _allocation):
        """The strip changes width when an icon comes or goes. The region is
        empty either way, but it costs one commit to be sure of it."""
        self.input_region_set = False

    def refresh(self, initial=False):
        for name, _icon, label in SWITCHES:
            value = read_switch(name)
            locked = value == ENGAGED
            if initial or self.state.get(name) != locked:
                self.state[name] = locked
                self.icons[name].set_visible(locked)
                if not initial:
                    print(f"{name}: {'ENGAGED' if locked else 'free'}", flush=True)
                    if name == "nwk_switch":
                        # In a thread: the D-Bus calls can take seconds, and
                        # the bar must not stand still while they do.
                        threading.Thread(
                            target=apply_network_extras,
                            args=(locked, self.verbose), daemon=True).start()
                elif self.verbose:
                    print(f"{name}: {'ENGAGED' if locked else 'free'}", flush=True)
        return True

    def watch(self):
        """Wake on sysfs when the driver notifies, and on a timer regardless.

        Whether the driver calls sysfs_notify() cannot be told by inspection,
        so both paths are wired up. If it does, the icon appears instantly and
        the timer finds nothing left to do; if it does not, the timer is what
        makes this work at all.
        """
        for name, _icon, _label in SWITCHES:
            try:
                fd = os.open(os.path.join(BASE, name), os.O_RDONLY)
            except OSError as err:
                print(f"{name}: {err}", file=sys.stderr)
                continue
            os.read(fd, 32)                      # arm the notification
            self.fd_add(
                self.GLib.PRIORITY_DEFAULT, fd,
                self.GLib.IOCondition.PRI | self.GLib.IOCondition.ERR,
                self.on_sysfs_event, name)
        self.GLib.timeout_add_seconds(self.interval, self.refresh)

    def forget_stale_mic_state(self):
        """Drop a verdict an older version left behind.

        It was written by a measurement that has not been repeated since and
        never will be. Left in state.json it would read like a current answer
        to anybody opening the file.
        """
        state = load_state()
        if state.pop("mic", None) is not None:
            save_state(state)

    def on_sysfs_event(self, fd, _condition, name):
        os.lseek(fd, 0, os.SEEK_SET)
        os.read(fd, 32)                          # re-arm, else we spin
        if self.verbose:
            print(f"{name}: sysfs reported the change by itself", flush=True)
        self.refresh()
        return True


def cmd_mic_check(_args):
    """Measure once, by hand, and report.

    The microphone switch has no readable state, so this opens the microphone
    for three seconds to tell the two apart. The running service never does
    this on its own -- the answer is only good for those three seconds.
    """
    result = measure_microphone()
    if result is None:
        print("Messung fehlgeschlagen (laeuft PipeWire, gibt es droid-source?)")
        return 1
    median, peak = result
    locked = classify_microphone(median)
    print(f"median RMS {median:.2f}  peak {peak}")
    print("Microphone: " + {True: "ENGAGED", False: "free",
                          None: "Messung unbrauchbar"}[locked])
    print(f"(threshold: median < {MIC_MAX_MEDIAN} counts as engaged; "
          f"unter {MIC_MIN_MEDIAN} als Fehlmessung)")
    print("Holds only for these three seconds: the switch announces itself "
          "nowhere, and there is no icon for it.")
    return 0 if locked is not None else 1


def cmd_run(args):
    indicator = Indicator(verbose=args.verbose, interval=args.interval)
    signal.signal(signal.SIGTERM, lambda *_: indicator.Gtk.main_quit())
    signal.signal(signal.SIGINT, lambda *_: indicator.Gtk.main_quit())
    indicator.Gtk.main()
    return 0


def main():
    # -v has to work on both sides of the subcommand: "run -v" is what anyone
    # types first, and having only the global form fail there cost a test run
    # on the device. SUPPRESS keeps the subparser default from overwriting a
    # flag that was already given in front of the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-v", "--verbose", action="store_true",
                        default=argparse.SUPPRESS,
                        help="jede Zustandsaenderung nach stdout melden")
    common.add_argument("--interval", type=int, default=argparse.SUPPRESS,
                        metavar="SEK",
                        help=f"seconds between checks "
                             f"(Vorgabe {DEFAULT_INTERVAL_S}); hoehere Werte "
                             f"make the icon appear correspondingly later")
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                     parents=[common])
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("run", parents=[common], help="show the icon (default)")
    st = sub.add_parser("status", parents=[common],
                        help="print the switch positions and exit")
    st.add_argument("--json", action="store_true",
                    help="everything as JSON, for the interface")
    sub.add_parser("mic-check", parents=[common],
                   help="measure the microphone once by hand (opens it briefly); "
                        "the service itself never measures")
    cam = sub.add_parser("cameras", parents=[common],
                         help="show which cameras the switch affects")
    cam.add_argument("--refresh", action="store_true",
                     help="fetch the list from the Android side again (needs root)")
    cfg = sub.add_parser("config", parents=[common],
                         help="set what the network switch switches off as well")
    cfg.add_argument("radio", nargs="?", choices=sorted(RADIOS),
                     help="wifi oder bluetooth")
    cfg.add_argument("value", nargs="?", choices=("on", "off"),
                     help="on = switch it off as well, off = leave it alone")
    args = parser.parse_args()
    args.verbose = getattr(args, "verbose", False)
    args.interval = getattr(args, "interval",
                            int(os.environ.get("FURIOS_KILLSWITCH_INTERVAL",
                                               DEFAULT_INTERVAL_S)))
    if args.interval < 1:
        print("--interval muss mindestens 1 Sekunde sein.", file=sys.stderr)
        return 2
    if args.command == "status":
        return cmd_status(args)
    if args.command == "mic-check":
        return cmd_mic_check(args)
    if args.command == "cameras":
        return cmd_cameras(args)
    if args.command == "config":
        return cmd_config(args)
    return cmd_run(args)


if __name__ == "__main__":
    sys.exit(main())
